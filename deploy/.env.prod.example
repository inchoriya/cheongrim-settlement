# EC2 배포용 환경변수 템플릿
# 복사: cp deploy/.env.prod.example deploy/.env.prod
# 실제 키는 deploy/.env.prod 에만 넣고, 절대 git 에 커밋하지 마세요.

# --- Web (HTTP only: deploy.sh) ---
WEB_PORT=80

# --- HTTPS (deploy-https.sh 사용 시 필수) ---
# 예: cheongrim.example.com  (A 레코드가 EC2 Elastic IP를 가리켜야 함)
DOMAIN=
ACME_EMAIL=

# --- MySQL ---
MYSQL_DATABASE=settlehub
MYSQL_USER=settlehub
MYSQL_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# --- Auth ---
# 최소 32바이트 이상 랜덤 문자열 권장
JWT_SECRET=change-me-to-a-long-random-secret-key-32b+
JWT_EXPIRATION_SECONDS=3600

# 데모면 true, 실제 공개/운영이면 false 권장
SEED_ENABLED=false

# --- CORS (프론트 접속 origin, 콤마 구분) ---
# 예: http://12.34.56.78,https://cheongrim.example.com
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# --- Payout PG ---
# mock(기본) | toss
PAYOUT_PROVIDER=mock
# toss 사용 시: deploy/.env.prod 에만 실제 키 작성 (example/깃허브에 넣지 말 것)
TOSS_SECRET_KEY=
TOSS_SECURITY_KEY=
# TOSS_BASE_URL=https://api.tosspayments.com
# TOSS_SCHEDULE_TYPE=SCHEDULED
# TOSS_PAYOUT_DATE=
